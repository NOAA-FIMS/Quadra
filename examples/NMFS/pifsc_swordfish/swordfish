#!/bin/sh
# Convenience entry point; all intake, validation and modeling run in C++.
case_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
binary="$case_dir/build/pifsc_swordfish"
if [ ! -x "$binary" ]; then
    echo "Build the native runner first: make pifsc_swordfish" >&2
    exit 1
fi
exec "$binary" "$@"
