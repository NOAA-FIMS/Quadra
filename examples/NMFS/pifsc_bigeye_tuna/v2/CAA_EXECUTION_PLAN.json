        "creates": [
          "FleetState"
        ],
        "updates": [
          "FleetState"
        ],
        "incoming_edges": [
          {
            "from": "PopulationPackage",
            "states": [
              "PopulationState"
            ]
          },
          {
            "from": "MovementPackage",
            "states": [
              "PopulationState"
            ]
          }
        ]
      }
    },
    {
      "phase": 5,
      "name": "observation",
      "purpose": "predict observations",
      "packages": [
