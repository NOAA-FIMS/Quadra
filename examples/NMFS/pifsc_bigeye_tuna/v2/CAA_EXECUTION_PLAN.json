      "derived_from": {
        "reason": "dependency_graph",
        "consumes": [
          "BigeyeModelData",
          "FleetParameters",
          "PopulationState",
          "FleetState"
        ],
        "creates": [],
        "updates": [
          "FleetState"
        ],
        "incoming_edges": [
          {
            "from": "FleetPackage",
            "states": [
              "FleetState"
