        "updates": [
          "LikelihoodState"
        ],
        "incoming_edges": [
          {
            "from": "FleetPackage",
            "states": [
              "FleetState"
            ]
          },
          {
            "from": "ObservationPackage",
            "states": [
              "FleetState"
            ]
          }
