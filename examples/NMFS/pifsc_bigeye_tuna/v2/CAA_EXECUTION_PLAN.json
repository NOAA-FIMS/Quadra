{
  "name": "Bigeye v2 CAA Execution Plan",
  "source": "examples/NMFS/pifsc_bigeye_tuna/v2/CAA_IR.json",
  "planner_version": 4,
  "scheduler": "field_dependency_scheduler_v1",
  "initial_fields": [
    "PopulationState.numbers_at_age"
  ],
  "rerunnable_packages": [
    "FleetPackage"
  ],
  "phases": [
    {
      "phase": 0,
      "name": "lifehistory",
      "purpose": "compute life-history state",
      "packages": [
        "LifeHistoryPackage"
      ],
      "derived_from": {
        "reason": "no_inputs",
        "inputs": [],
        "outputs": [
          "LifeHistoryState.m_at_age",
          "LifeHistoryState.weight_at_age",
          "LifeHistoryState.maturity_at_age"
        ]
      }
    },
    {
      "phase": 1,
      "name": "fleet_bootstrap",
      "purpose": "initialize fleet mortality before population dynamics",
      "packages": [
        "FleetPackage"
      ],
      "derived_from": {
        "reason": "bootstrap_from_initial_fields",
        "inputs": [
          "LifeHistoryState.m_at_age",
          "LifeHistoryState.weight_at_age",
          "PopulationState.numbers_at_age"
        ],
        "outputs": [
          "FleetState.selectivity_at_age",
          "FleetState.f_at_age",
          "FleetState.z_at_age",
          "FleetState.catch_numbers_at_age",
          "FleetState.catch_biomass_at_age",
          "FleetState.total_catch_biomass_by_year"
        ]
      }
    },
    {
      "phase": 2,
      "name": "population",
      "purpose": "advance population state",
      "packages": [
        "PopulationPackage"
      ],
      "derived_from": {
        "reason": "field_dependency_graph",
        "inputs": [
          "LifeHistoryState.m_at_age",
          "LifeHistoryState.weight_at_age",
          "LifeHistoryState.maturity_at_age",
          "FleetState.z_at_age"
        ],
        "outputs": [
          "PopulationState.recruits_by_year",
          "PopulationState.numbers_at_age",
          "PopulationState.survivors_at_age",
          "PopulationState.spawning_biomass_by_year"
        ],
        "incoming_edges": []
      }
    },
    {
      "phase": 3,
      "name": "movement",
      "purpose": "move individuals across populations",
      "packages": [
        "MovementPackage"
      ],
      "derived_from": {
        "reason": "field_dependency_graph",
        "inputs": [
          "PopulationState.numbers_at_age"
        ],
        "outputs": [
          "PopulationState.numbers_at_age"
        ],
        "incoming_edges": [
          {
            "from": "PopulationPackage",
            "items": [
              "PopulationState.numbers_at_age"
            ]
          }
        ]
      }
    },
    {
      "phase": 4,
      "name": "fleet",
      "purpose": "recompute fleet predictions after population dynamics",
      "packages": [
        "FleetPackage"
      ],
      "derived_from": {
        "reason": "field_dependency_graph",
        "inputs": [
          "LifeHistoryState.m_at_age",
          "LifeHistoryState.weight_at_age",
          "PopulationState.numbers_at_age"
        ],
        "outputs": [
          "FleetState.selectivity_at_age",
          "FleetState.f_at_age",
          "FleetState.z_at_age",
          "FleetState.catch_numbers_at_age",
          "FleetState.catch_biomass_at_age",
          "FleetState.total_catch_biomass_by_year"
        ],
        "incoming_edges": [
          {
            "from": "PopulationPackage",
            "items": [
              "PopulationState.numbers_at_age"
            ]
          },
          {
            "from": "MovementPackage",
            "items": [
              "PopulationState.numbers_at_age"
            ]
          }
        ]
      }
    },
    {
      "phase": 5,
      "name": "observation",
      "purpose": "predict observations",
      "packages": [
        "ObservationPackage"
      ],
      "derived_from": {
        "reason": "field_dependency_graph",
        "inputs": [
          "PopulationState.spawning_biomass_by_year",
          "FleetState.catch_numbers_at_age"
        ],
        "outputs": [
          "FleetState.predicted_index_by_year",
          "FleetState.predicted_catch_age_proportion"
        ],
        "incoming_edges": [
          {
            "from": "FleetPackage",
            "items": [
              "FleetState.catch_numbers_at_age"
            ]
          },
          {
            "from": "PopulationPackage",
            "items": [
              "PopulationState.spawning_biomass_by_year"
            ]
          }
        ]
      }
    },
    {
      "phase": 6,
      "name": "likelihood",
      "purpose": "evaluate likelihood components",
      "packages": [
        "LikelihoodPackage"
      ],
      "derived_from": {
        "reason": "field_dependency_graph",
        "inputs": [
          "FleetState.total_catch_biomass_by_year",
          "FleetState.predicted_index_by_year",
          "FleetState.predicted_catch_age_proportion"
        ],
        "outputs": [
          "LikelihoodState.catch_nll",
          "LikelihoodState.index_nll",
          "LikelihoodState.agecomp_nll",
          "LikelihoodState.total_nll"
        ],
        "incoming_edges": [
          {
            "from": "FleetPackage",
            "items": [
              "FleetState.total_catch_biomass_by_year"
            ]
          },
          {
            "from": "ObservationPackage",
            "items": [
              "FleetState.predicted_index_by_year",
              "FleetState.predicted_catch_age_proportion"
            ]
          }
        ]
      }
    }
  ],
  "diagnostics": []
}
