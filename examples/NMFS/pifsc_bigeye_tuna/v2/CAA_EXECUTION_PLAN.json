      ],
      "derived_from": {
        "reason": "bootstrap_from_initial_state",
        "consumes": [
          "BigeyeModelData",
          "FleetParameters",
          "LifeHistoryState",
          "PopulationState"
        ],
        "creates": [
          "FleetState"
        ],
        "updates": [
          "FleetState"
        ]
      }
    },
    {
